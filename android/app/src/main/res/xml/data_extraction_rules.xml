<?xml version="1.0" encoding="utf-8"?>
<!-- Saved trips move to a new phone with Android's backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
