# Copy this file to .env (in this same folder) and fill it in. Never share .env or commit it.

# Your Duffel access token, from https://app.duffel.com → Developers → Access tokens.
# Start with a TEST token (duffel_test_...): real flights, test bookings, nothing charged.
# Leave it empty to run with demo flights.
DUFFEL_TOKEN=

# Live tokens (duffel_live_...) search real fares. Real bookings are paid from your Duffel balance,
# so they stay off until the app collects payment from travellers. Only then set this to: on
LIVE_BOOKINGS=off

# Optional: a shared key the app must send in X-App-Key. Put the same value in the app's build settings.
APP_KEY=

# The port the server listens on.
PORT=8787
